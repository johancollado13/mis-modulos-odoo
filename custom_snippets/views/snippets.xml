<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="s_custom_banner" name="Banner Promocional Custom">
            <section class="s_custom_banner o_colored_level pt64 pb64 bg-100" data-snippet="s_custom_banner">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <h2 class="display-4 fw-bold text-primary">Nueva Colección</h2>
                            <p class="lead text-muted">
                                Diseño minimalista pensado para el entorno profesional moderno.
                            </p>
                            <a href="/shop" class="btn btn-primary btn-lg rounded-pill px-4">Ver Catálogo</a>
                        </div>
                        <div class="col-lg-6 text-center">
                            <img src="/web/static/img/placeholder.png" class="img img-fluid mx-auto" style="max-height: 350px;" alt="Promo Image"/>
                        </div>
                    </div>
                </div>
            </section>
        </template>

        <template id="external_snippets_inherit" inherit_id="website.snippets" name="Custom Snippets Block">
            <xpath expr="//div[@id='snippet_structure']//div[@class='o_panel_body']" position="inside">
                <t t-snippet="custom_snippets.s_custom_banner" 
                   t-string="Mi Banner Custom"/>
            </xpath>
        </template>
    </data>
</odoo>