<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_activo_custom" model="ir.ui.view">
        <field name="name">product.template.form.activo.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][@options]" position="after">
                <field name="activo_custom"/>
            </xpath>
        </field>
    </record>
</odoo>
